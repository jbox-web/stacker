# Ignore generated data
/docs/
/lib/
/dist/
/coverage/

# Assembled from licenses.manifest by scripts/harvest-licenses.sh (mise dev:licenses)
/licenses/

# Ignore all bin files
/bin/*
!/bin/.keep

# Ignore MacOS files
.DS_Store

# Ignore spectator's failing-example cache
/.spectator-failures

# Ignore all log files
/log/*
!/log/.keep
/example/log/*
!/example/log/.keep
