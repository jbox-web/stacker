module Stacker
  # The third-party notices the released binary has to carry, embedded at
  # compile time. A statically linked binary contains its dependencies' code,
  # so it has to contain their notices too.
  #
  # Embedded with the stdlib macros alone (`read_file` plus a backtick `ls`),
  # as crystalreleaser does.
  #
  # The folder is generated by scripts/harvest-licenses.sh (`mise
  # dev:licenses`) from licenses.manifest, and is gitignored. It has to exist
  # before this file is compiled, which is why every compiling task declares
  # that script as a dependency. An empty or missing folder is a compile error
  # by design: a binary shipped without its notices is the failure this module
  # exists to prevent.
  module Licenses
    # Each top-level `{% %}` is its own macro expansion, so the whole block
    # lives in one `{% begin %}` for the macro variables to be shared.
    {% begin %}
      {% dir = "#{__DIR__}/../../licenses" %}
      {% names = `ls -1 "#{dir.id}" 2>/dev/null || true`.stringify.lines.reject(&.empty?) %}
      {% raise "licenses/ is missing or empty: run `mise dev:licenses` before compiling" if names.empty? %}

      # File name => notice text, sorted by file name.
      FILES = {
        {% for name in names.sort %}
          {{ name }} => {{ read_file("#{dir.id}/#{name.id}") }},
        {% end %}
      }
    {% end %}

    # What `stacker licenses` prints: every notice under a `==> name <==`
    # header, separated by a blank line.
    def self.text : String
      String.build do |io|
        FILES.each_with_index do |(name, notice), index|
          io.puts if index > 0
          io.puts "==> #{name} <=="
          io.print notice
        end
      end
    end
  end
end
